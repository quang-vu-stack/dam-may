PORT=3000
CLOUD_STORAGE_DIR=D:/VU-CLOUD
CLOUD_ADMIN_USER=admin
# Generate password hash with: npm run hash -- "your long password"
CLOUD_ADMIN_PASSWORD_HASH=
# Long random secret; use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
COOKIE_SECURE=false
MAX_FILE_MB=128
